{erl_opts, [debug_info, "-Wno-deprecated-catch"]}.

{deps, [
  {cowboy, "2.12.0"},
  {recon, "2.5.6"},
  {prometheus, "4.11.0"},
  {thoas, "1.2.0"}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p29_flotilla_de_reparto]}
]}.

{relx, [
  {release, {p29_flotilla_de_reparto, "0.2.0"}, [p29_flotilla_de_reparto, sasl, recon]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true},
  %% ERTS empaquetado: el release no depende del erl del PATH. En la RPi el
  %% `bash -lc` de systemd resetea PATH y resolvia /usr/bin/erl (OTP 23), que
  %% no puede cargar los beams de OTP 27. Con include_erts/system_libs en true
  %% el release trae su propio runtime y arranca aunque el PATH este mal.
  {include_erts, true},
  {system_libs, true}
]}.
