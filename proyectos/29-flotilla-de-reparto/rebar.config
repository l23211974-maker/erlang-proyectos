{erl_opts, [debug_info, "-Wno-deprecated-catch"]}.

{deps, [
  {cowboy, "2.12.0"},
  {recon, "2.5.6"},
  {prometheus, "4.11.0"},
  {thoas, "1.2.0"}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p29_flotilla_de_reparto]}
]}.

{relx, [
  {release, {p29_flotilla_de_reparto, "0.2.0"}, [p29_flotilla_de_reparto, sasl, recon]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true}
]}.