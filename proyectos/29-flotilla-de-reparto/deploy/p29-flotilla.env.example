# Plantilla del entorno del servicio #29. Copiar a /etc/p29-flotilla.env,
# generar una cookie propia y restringir permisos:
#
#   sudo cp deploy/p29-flotilla.env.example /etc/p29-flotilla.env
#   COOKIE=$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 24)
#   sudo sed -i "s/^P29_COOKIE=.*/P29_COOKIE=$COOKIE/" /etc/p29-flotilla.env
#   sudo chmod 600 /etc/p29-flotilla.env
#
# Este archivo NO lleva secretos reales: el valor de abajo es placeholder.
P29_COOKIE=cambiar_esta_cookie_por_una_aleatoria
