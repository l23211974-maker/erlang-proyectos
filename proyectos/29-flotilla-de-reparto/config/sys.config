[
  {p29_flotilla_de_reparto, [
    %% demo x300: un dia de 6 h (2160 ticks de GPS de 10 s) corre en ~72 s
    {tick_interval_ms, 33},
    {reloj_auto, true},
    {ticks_jornada, 2160},
    {vehiculos, 15},
    {entregas, 900},
    %% paradas: 60 entregas por unidad en 6 h -> ~3 min por entrega (18 ticks);
    %% 36 ticks cubre conduccion + servicio en la rejilla simulada
    {ticks_por_parada, 36},
    {sin_senal_ticks, 6},          %% 60 s sin GPS -> alerta y reasignacion
    {capacidad_kg, 2500},          %% unidad urbana: carga de ~2.5 t
    {prob_fallida, 0.10},          %% punto medio del rango 5-15% del enunciado
    {asignar_al_inicio, true}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
