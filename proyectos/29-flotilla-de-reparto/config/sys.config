[
  {p29_flotilla_de_reparto, [
    %% demo x300: una jornada de 6 h (2160 reportes ADS-B de 10 s simulados)
    %% corre en ~72 s reales
    {tick_interval_ms, 33},
    {reloj_auto, true},
    {ticks_jornada, 2160},
    {aeronaves, 15},
    {envios, 900},
    %% entrega: 60 envios por aeronave en 6 h -> 36 ticks (6 min simulados)
    %% por entrega; cubre el tramo terminal y el servicio de carga en tierra
    {ticks_por_parada, 36},
    {sin_senal_ticks, 6},          %% 60 s sin reporte ADS-B -> sin_senal y reasignacion
    {prob_fallida, 0.10},          %% punto medio del rango 5-15% del enunciado
    {prob_desvio, 0.02},           %% desvio por meteo al completar llegada (2%)
    {asignar_al_inicio, true},
    {web_port, 8080}               %% HTTP de la UI: /, /api/*, /eventos (SSE), /metrics
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
