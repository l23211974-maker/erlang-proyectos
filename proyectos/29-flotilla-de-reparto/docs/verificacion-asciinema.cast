[277.957373, "o", "-module(p29_demo).\r\n-export([main/0]).\r\n\r\n%% Lanza la jornada completa (2160 ticks) en el nodo del servicio y sale.\r\nmain() ->\r\n    Nodo = 'p29_flotilla_de_reparto@127.0.0.1',\r\n    io:format(\"lanzando jornada en ~s~n\", [Nodo]),\r\n    io:format(\"simulador -> ~p~n\", [rpc:call(Nodo, p29_simulador, demo, [])]),\r\n    halt(0).\r\n\r\n"]
