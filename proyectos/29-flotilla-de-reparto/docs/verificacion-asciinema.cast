[80.793447, "o", "\u001b[2;37mArbol limpio y sin rebar.lock: el lock fijaba prometheus 6.x (exige OTP 26+)\u001b[0m\r\n\u001b[2;37my rompia la compilacion en OTP 25. Aqui se usa prometheus 4.11.0.\u001b[0m\r\n\r\n"]
