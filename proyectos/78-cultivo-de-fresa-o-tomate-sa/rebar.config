{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
  {cowboy, "2.12.0"},
  {recon, "2.5.6"}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p78_cultivo_de_fresa_o_tomate_sa]}
]}.

{relx, [
  {release, {p78_cultivo_de_fresa_o_tomate_sa, "0.1.0"}, [p78_cultivo_de_fresa_o_tomate_sa, sasl, recon]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true}
]}.
