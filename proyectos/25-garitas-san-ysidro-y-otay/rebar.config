{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
  {cowboy, "2.12.0"},
  {recon, "2.5.6"}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p25_garitas_san_ysidro_y_otay]}
]}.

{relx, [
  {release, {p25_garitas_san_ysidro_y_otay, "0.1.0"}, [p25_garitas_san_ysidro_y_otay, sasl, recon]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true}
]}.
