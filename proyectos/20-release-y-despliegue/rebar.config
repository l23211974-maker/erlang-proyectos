{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
  {cowboy, "2.12.0"},
  {recon, "2.5.6"}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [p20_release_y_despliegue]}
]}.

{relx, [
  {release, {p20_release_y_despliegue, "0.1.0"}, [p20_release_y_despliegue, sasl, recon]},
  {sys_config, "config/sys.config"},
  {vm_args, "config/vm.args"},
  {mode, prod},
  {extended_start_script, true}
]}.
